+          sx, w, bgx & 0x3ff, bgy & 0x3ff, ppu->hScroll[layer],
+          ppu->vScroll[layer], map_word, map_word & 31, (map_word >> 5) & 31,
+          real, (unsigned)served & 0xffff);
