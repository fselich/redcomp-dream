+    SDL_Delay(8);
+    frames++;
+  }
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  OverlayNoteClosed();
+  host_report_breadcrumb("title options menu CLOSED after %u pumps - guest resuming",
+                         frames);
+}
