+/* Test-only BG pixel-source probe (SNESRECOMP_BGPROBE_FRAME=N[,M]).
+ * Logs, for every tile span the 4bpp renderer draws on the probed frames,
+ * the screen span, the BG coordinates and the exact VRAM map word it was
+ * fetched from. One CSV row per span; pixel sx..sx+w-1 came from map_word.
+ * SNESRECOMP_BGPROBE_LAYERS = layer bitmask (default 1 = BG1),
+ * SNESRECOMP_BGPROBE_FILE = output path (default stderr). */
+static int s_bgprobe_init, s_bgprobe_f0 = -1, s_bgprobe_f1 = -1;
+static unsigned s_bgprobe_layers = 1;
+static FILE *s_bgprobe_out;
+
+static bool PpuBgProbeActive(uint layer) {
+  if (!s_bgprobe_init) {
+    s_bgprobe_init = 1;
+    const char *e = getenv("SNESRECOMP_BGPROBE_FRAME");
+    if (e && *e) {
+      s_bgprobe_f0 = s_bgprobe_f1 = atoi(e);
+      const char *c = strchr(e, ',');
+      if (c) s_bgprobe_f1 = atoi(c + 1);
+      const char *l = getenv("SNESRECOMP_BGPROBE_LAYERS");
+      if (l && *l) s_bgprobe_layers = (unsigned)strtoul(l, NULL, 0);
+      const char *p = getenv("SNESRECOMP_BGPROBE_FILE");
+      s_bgprobe_out = (p && *p) ? fopen(p, "w") : NULL;
+      if (!s_bgprobe_out) s_bgprobe_out = stderr;
+      fprintf(s_bgprobe_out, "frame,layer,sy,sx,w,bgx,bgy,hscroll,vscroll,"
+                             "map_word,map_x,map_y,real,served\n");
+    }
+  }
+  return s_bgprobe_f0 >= 0 && (s_bgprobe_layers >> layer & 1) &&
+         snes_frame_counter >= s_bgprobe_f0 &&
+         snes_frame_counter <= s_bgprobe_f1;
