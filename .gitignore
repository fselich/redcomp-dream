# Local-only inputs and ROM-derived artifacts. Never commit the ROM.
/rom/
*.sfc
*.smc
*.srm

# Root design sources (banner, box art, logos) stay local; only the
# processed TGAs in game/launcher_assets/ are committed.
/*.png
/*.webp

# Build and test artifacts that a vendored checkout can pick up.
/game/snesrecomp/recompiler-rs/target/
/game/snesrecomp/lib/recomp-net/rb_driver_test_*.log

# Local workshop / research captures. Keep the durable docs and tools, not the
# raw ROM-derived logs, frames, dumps or old project copies.
/work/

# Build trees, generated C and local runtime state.
/game/build/
/game/build-*/
/game/.cache/
/game/dist/
/game/saves/
/game/src/gen/
/game/recomp/funcs.h
/game/config.ini
/game/keybinds.ini
/game/input.ini
/game/rom.cfg
/game/rom_probe.json
/game/last_run_report.json

# Local agent/editor configuration.
/.claude/
/.opencode/
/game/.claude/
/game/.opencode/

# Python bytecode from the research scripts.
__pycache__/
*.pyc

.DS_Store
