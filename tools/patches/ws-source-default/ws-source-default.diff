-        else mode = 0;
+        const char *legacy = getenv("SNESRECOMP_WS_TRACK_CLAMP");
+        if (!e || !*e) mode = (legacy && *legacy) ? WS_OW_CLAMP : WS_OW_SOURCE;
+        else if (!strcmp(e, "0") || !strcmp(e, "off") || !strcmp(e, "wrap"))
+            mode = WS_OW_WRAP;
+        else if (!strcmp(e, "ring")) mode = WS_OW_RING;
+        else if (!strcmp(e, "source")) mode = WS_OW_SOURCE;
+        else if (!strcmp(e, "ghost")) mode = WS_OW_GHOST;
+        else if (!strcmp(e, "clamp")) mode = WS_OW_CLAMP;
+        else {
+            fprintf(stderr, "[ws-ow] unknown SNESRECOMP_WS_OFFWINDOW='%s'; "
+                            "using source\n", e);
+            mode = WS_OW_SOURCE;
+        }
     }
     return mode;
 }
 
+/* Margin hooks run for the modes that substitute margin cells. */
+static int WsOffwindowHooked(int mode)
+{
+    return mode == WS_OW_RING || mode == WS_OW_SOURCE || mode == WS_OW_GHOST;
+}
+
+static int WsOwVerbose(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char *a = getenv("SNESRECOMP_WS_OFFWINDOW_LOG");
+        const char *b = getenv("SNESRECOMP_WS_SOURCE_LOG");
+        v = (a && *a) || (b && *b);
+    }
+    return v;
+}
