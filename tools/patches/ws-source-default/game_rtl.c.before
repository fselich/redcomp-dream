/*
 * Uniracers — per-game runtime glue.
 *
 * THIS FILE IS THE PORT. Everything else the scaffold produced is layout,
 * build wiring, and packaging; this is where the actual work happens.
 *
 * The framework does not, and cannot, drive an arbitrary SNES game on its
 * own. Two responsibilities always land on the game host:
 *
 *   1. Deciding what "one frame" means for THIS title, and returning from
 *      run_frame() at that boundary. A real ROM's reset vector never
 *      returns — it enters a main loop that waits on vblank — so somebody
 *      has to choose the yield point.
 *   2. Delivering NMI/IRQ at the hardware edge (see
 *      snesrecomp/docs/FRAME_MODEL_HOSTS.md).
 *
 * A new port starts on the framework's beam-aligned driver
 * (runner/src/beam_frame_driver.h): one frame is one PPU field, cut at the
 * beam's vblank edge; interrupts -- raster splits and a coprocessor's IRQ
 * line -- are taken where the beam latches them; parked time still runs the
 * beam, APU and coprocessors; and the field is rasterized from the raster
 * journal with real HDMA. It is the framework's, so a fix to it reaches this
 * port on a submodule pull.
 *
 * This file used to hold its own copy of a simpler driver: frames measured
 * from wherever the CPU last stopped, NMI delivered at an arbitrary beam
 * position, the field drawn with end-of-frame register state. A game that
 * uploads in vblank between INIDISP=$80 and $0F flickered black, and one
 * that chains raster splits fell apart. Replace these calls only for what
 * the driver does not do; MetalWarriorsSNESRecomp's src/mw_rtl.c and
 * GundamWingEndlessDuelSNESRecomp's src/game_rtl.c are developed examples of
 * title-specific drivers.
 */

#include "game_rtl.h"

#include "beam_frame_driver.h"
#include "config.h"
#include "common_rtl.h"
#include "cpu_state.h"
#include "snes/ppu.h"
#include "snes/snes.h"
#include "snes_runahead.h"

#include <limits.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

extern Ppu *g_ppu;
extern int snes_netplay_active(void);

/* Debug-only P8 probe: override one OAM slot for the presentation pass.
 * Format: slot:x:y:tile:attr:big. It runs after the game logic and before
 * the rasterizer, so it cannot change simulation; unset in normal runs.
 * Compiled only into trace builds; release builds get the stub below. */
#if SNESRECOMP_TRACE
static void WsInjectTestOam(Ppu *ppu)
{
    const char *spec = getenv("SNESRECOMP_WS_TEST_OAM");
    if (!spec || !*spec || !ppu) return;
    char buf[256];
    snprintf(buf, sizeof(buf), "%s", spec);
    uint8 hints[16] = {0};
    int any_hint = 0;
    for (char *p = strtok(buf, ";"); p; p = strtok(NULL, ";")) {
        int slot, x, y, tile, attr, big;
        if (sscanf(p, "%d:%d:%d:%d:%d:%d",
                   &slot, &x, &y, &tile, &attr, &big) != 6)
            continue;
        if (slot < 0 || slot > 127) continue;
        ppu->oam[slot * 2] = (uint16)(((y & 0xFF) << 8) | (x & 0xFF));
        ppu->oam[slot * 2 + 1] = (uint16)(((attr & 0xFF) << 8) | (tile & 0xFF));
        uint8 *hb = &ppu->highOam[slot >> 2];
        int sh = (slot & 3) * 2;
        *hb = (uint8)((*hb & ~(3u << sh)) |
                      ((((x >> 8) & 1u) << sh)) |
                      (((big & 1u) << (sh + 1))));
        hints[slot >> 3] |= (uint8)(1u << (slot & 7));
        any_hint = 1;
    }
    const char *hint = getenv("SNESRECOMP_WS_TEST_OAM_LEFT_HINT");
    if (any_hint && hint && *hint && strcmp(hint, "0") != 0)
        PpuWsSetOamLeftHints(ppu, hints);
}
#else
static void WsInjectTestOam(Ppu *ppu) { (void)ppu; }
#endif

static int WideEnabled(void)
{
    const char *e = getenv("SNESRECOMP_WS");
    if (e && *e) return strcmp(e, "0") != 0;
    return g_config.widescreen;
}

static int InLiveRace(void)
{
    return g_ram[0x000B4] == 1 && g_ram[0x00EE9] == 0 &&
           g_ram[0x00300] <= 1;
}

/* P2c HUD: BG3 is separate rigid groups, not one continuous bar. Keep the
 * normal clamp for the prompt/arrow/lap-time rows, and on the top band copy
 * the left group (RACE / 0/3, source 17..64) to the left edge and the timer
 * (source 193..256) to the right edge. Equal source/destination widths make
 * both segments 1:1, so glyphs are never resampled. The 17 px left inset is
 * deliberately removed by the left segment; the 17 px right inset is kept.
 * SNESRECOMP_WS_HUD=0 restores the clamp. */
static int WsHudEnabled(void)
{
    const char *e = getenv("SNESRECOMP_WS_HUD");
    if (e && *e) return strcmp(e, "0") != 0;
    return 1;
}

static void WsApplyHud(Ppu *ppu)
{
    if (!ppu) return;
    if (!WideEnabled() || !InLiveRace() || !WsHudEnabled()) {
        PpuSetWidescreenLayerElasticBandSlot(ppu, 0, 2, 0, 0, NULL, 0);
        PpuSetWidescreenBg3Widen(ppu, 0);
        return;
    }
    /* BG3 needs its own widen gate before the elastic band is consulted. */
    PpuSetWidescreenBg3Widen(ppu, 17);
    const PpuWsElasticSeg segs[2] = {
        { 17, 64, -39, 8 },     /* left group + 4 px inset, 1:1 */
        { 193, 256, 236, 299 }, /* timer + right inset, 1:1 */
    };
    PpuSetWidescreenLayerElasticBandSlot(ppu, 0, 2, 17, 31, segs, 2);
}

/* The object cull compares screen X against $0421 (left) and $0423 (right).
 * Those two words are only written by the rider setup at $81:A385.. and only
 * read by the five CMP sites at $82:AD19/ADE7/AEA7/AF75/AFFE, so shifting
 * them is a pure cull change: spawn, AI, camera, collision and RNG never see
 * them. At frame 3500 the native window is [-49, 256]; 16:9 needs [-92, 299]
 * so the CPU ghost can reach the widened right margin. Keep the vertical
 * window and every other object path untouched. */
#define WS_CULL_MARGIN 43
#define WS_CULL_LEFT   0x0421
#define WS_CULL_RIGHT  0x0423

static int s_cull_on;
static uint16 s_cull_base_l, s_cull_base_r;
static uint16 s_cull_applied_l, s_cull_applied_r;

typedef struct {
    int on;
    uint16 base_l, base_r, applied_l, applied_r;
} WsCullState;

static void WsCullGet(WsCullState *s)
{
    s->on = s_cull_on;
    s->base_l = s_cull_base_l;
    s->base_r = s_cull_base_r;
    s->applied_l = s_cull_applied_l;
    s->applied_r = s_cull_applied_r;
}

static void WsCullSet(const WsCullState *s)
{
    s_cull_on = s->on;
    s_cull_base_l = s->base_l;
    s_cull_base_r = s->base_r;
    s_cull_applied_l = s->applied_l;
    s_cull_applied_r = s->applied_r;
}

static int WsCullEnabled(void)
{
    const char *e = getenv("SNESRECOMP_WS_CULL");
    if (e && *e) return strcmp(e, "0") != 0;
    return 1;
}

static uint16 WsRead16(uint16 addr)
{
    return (uint16)(g_ram[addr] | ((uint16)g_ram[(uint16)(addr + 1)] << 8));
}

static void WsWrite16(uint16 addr, uint16 value)
{
    g_ram[addr] = (uint8)(value & 0xFF);
    g_ram[(uint16)(addr + 1)] = (uint8)(value >> 8);
}

static void WsRestoreCull(void)
{
    if (!s_cull_on) return;
    /* Only restore if the game has not replaced our widened value. */
    if (WsRead16(WS_CULL_LEFT) == s_cull_applied_l &&
        WsRead16(WS_CULL_RIGHT) == s_cull_applied_r) {
        WsWrite16(WS_CULL_LEFT, s_cull_base_l);
        WsWrite16(WS_CULL_RIGHT, s_cull_base_r);
    }
    s_cull_on = 0;
}

static void WsApplyCull(void)
{
    if (!WideEnabled() || !InLiveRace() || !WsCullEnabled()) {
        WsRestoreCull();
        return;
    }

    uint16 cur_l = WsRead16(WS_CULL_LEFT);
    uint16 cur_r = WsRead16(WS_CULL_RIGHT);

    /* Reuse the base while our widened values are in place. A different pair
     * means the game just installed a new per-section/per-rider base. */
    if (!s_cull_on || cur_l != s_cull_applied_l || cur_r != s_cull_applied_r) {
        /* Wait for a plausible native screen window: setup writes 0 first. */
        if ((int16)cur_l > 0 || cur_r < 128) {
            s_cull_on = 0;
            return;
        }
        s_cull_base_l = cur_l;
        s_cull_base_r = cur_r;
    }

    s_cull_applied_l = (uint16)((int16)s_cull_base_l - WS_CULL_MARGIN);
    s_cull_applied_r = (uint16)(s_cull_base_r + WS_CULL_MARGIN);
    WsWrite16(WS_CULL_LEFT, s_cull_applied_l);
    WsWrite16(WS_CULL_RIGHT, s_cull_applied_r);
    s_cull_on = 1;
}

/* Test-only generator probe. It runs the real stage 1/2 on a snapshot of a
 * live race frame and logs the inputs, raw source words and outputs. This is
 * deliberately not a production path; it exists to decode the table/world
 * mapping before any wide-map renderer is written. */
static void WsTestGen(void)
{
    static int done;
    const char *enable = getenv("SNESRECOMP_WS_TEST_GEN");
    if (done || !enable || !*enable || !InLiveRace()) return;
    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
    int trigger = frame_env && *frame_env ? atoi(frame_env) : 5000;
    if (snes_frame_counter < trigger) return;
    done = 1;

    CpuState saved_cpu = g_cpu;
    static uint8 saved_ram[0x20000];
    memcpy(saved_ram, g_ram, sizeof(saved_ram));

    fprintf(stderr,
            "[wsmap] frame=%d a5=%04x a7=%04x 0405=%04x 0407=%04x "
            "04f1=%04x 04f3=%04x 0232=%04x 0234=%04x 0236=%04x "
            "0238=%04x\n",
            snes_frame_counter, WsRead16(0x00A5), WsRead16(0x00A7),
            WsRead16(0x0405), WsRead16(0x0407), WsRead16(0x04F1),
            WsRead16(0x04F3), WsRead16(0x0232), WsRead16(0x0234),
            WsRead16(0x0236), WsRead16(0x0238));

    for (int off = -512; off <= 512; off += 8) {
        memcpy(g_ram, saved_ram, sizeof(saved_ram));
        g_cpu = saved_cpu;
        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
        RecompReturn r1 = cpu_dispatch_call_pc(&g_cpu, 0x818A4A, 0x818A4A);
        fprintf(stderr,
                "[wsgen1] off=%d ret=%d a5=%04x 0405=%04x 0407=%04x "
                "0232=%04x 0234=%04x 0236=%04x 0238=%04x "
                "0260=%04x 0262=%04x 0264=%04x 0266=%04x "
                "0268=%04x 026a=%04x 026c=%04x 026e=%04x "
                "0270=%04x 0272=%04x\n",
                off, (int)r1, WsRead16(0x00A5), WsRead16(0x0405),
                WsRead16(0x0407), WsRead16(0x0232), WsRead16(0x0234),
                WsRead16(0x0236), WsRead16(0x0238), WsRead16(0x0260),
                WsRead16(0x0262), WsRead16(0x0264), WsRead16(0x0266),
                WsRead16(0x0268), WsRead16(0x026A), WsRead16(0x026C),
                WsRead16(0x026E), WsRead16(0x0270), WsRead16(0x0272));

        memcpy(g_ram, saved_ram, sizeof(saved_ram));
        g_cpu = saved_cpu;
        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
        RecompReturn r2 = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
        fprintf(stderr,
                "[wsgen2] off=%d ret=%d a5=%04x 0230=%04x 0232=%04x "
                "0234=%04x 0236=%04x 0238=%04x 023a=%04x 023c=%04x "
                "023e=%04x 0240=%04x 0242=%04x\n",
                off, (int)r2, WsRead16(0x00A5), WsRead16(0x0230),
                WsRead16(0x0232), WsRead16(0x0234), WsRead16(0x0236),
                WsRead16(0x0238), WsRead16(0x023A), WsRead16(0x023C),
                WsRead16(0x023E), WsRead16(0x0240), WsRead16(0x0242));
        fflush(stderr);
    }

    memcpy(g_ram, saved_ram, sizeof(saved_ram));
    g_cpu = saved_cpu;
}

/* Test-only: preload the stage-1 segment buffer and run stage 2 directly
 * (entry after the stage-1 JSR at $8B98). This isolates the stage-1 -> stage-2
 * conversion without modifying the guest routine. */
static void WsTestStage2(void)
{
    static int done;
    const char *enable = getenv("SNESRECOMP_WS_TEST_STAGE2");
    if (done || !enable || !*enable || !InLiveRace()) return;
    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
    int trigger = frame_env && *frame_env ? atoi(frame_env) : 3504;
    if (snes_frame_counter < trigger) return;
    done = 1;

    CpuState saved_cpu = g_cpu;
    static uint8 saved_ram[0x20000];
    memcpy(saved_ram, g_ram, sizeof(saved_ram));
    static const uint16 vals[] = {
        0x0001, 0x0004, 0x0100, 0x0400, 0x0800, 0x1000,
        0x1800, 0x1C00, 0x1C01, 0x1C04, 0x2000, 0x2024,
        0x3000, 0x4800, 0x7FFF
    };
    for (unsigned k = 0; k < sizeof(vals) / sizeof(vals[0]); k++) {
        memcpy(g_ram, saved_ram, sizeof(saved_ram));
        g_cpu = saved_cpu;
        for (int i = 0; i < 10; i++)
            WsWrite16((uint16)(0x0260 + i * 2), vals[k]);
        WsWrite16(0x12C7, 0);
        WsWrite16(0x0200, 0);
        WsWrite16(0x0202, 0);
        WsWrite16(0x0EEF, 0);
        RecompReturn r = cpu_dispatch_call_pc(&g_cpu, 0x818B98, 0x818B98);
        fprintf(stderr, "[wsst2] val=%04x ret=%d 0230=%04x 0232=%04x "
                        "0234=%04x 0236=%04x 0238=%04x 023a=%04x "
                        "023c=%04x 023e=%04x 0240=%04x 0242=%04x "
                        "0fab=%04x 0eef=%04x\n",
                vals[k], (int)r, WsRead16(0x0230), WsRead16(0x0232),
                WsRead16(0x0234), WsRead16(0x0236), WsRead16(0x0238),
                WsRead16(0x023A), WsRead16(0x023C), WsRead16(0x023E),
                WsRead16(0x0240), WsRead16(0x0242), WsRead16(0x0FAB),
                WsRead16(0x0EEF));
        fflush(stderr);
    }
    memcpy(g_ram, saved_ram, sizeof(saved_ram));
    g_cpu = saved_cpu;
}

/* Test-only: scan horizontal world offsets through the real stage 2, logging
 * whether the resulting BG1 staging column is nonblank. */
static void WsTestStage2Scan(void)
{
    static int done;
    const char *enable = getenv("SNESRECOMP_WS_TEST_STAGE2_SCAN");
    if (done || !enable || !*enable || !InLiveRace()) return;
    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
    int trigger = frame_env && *frame_env ? atoi(frame_env) : 3504;
    if (snes_frame_counter < trigger) return;
    done = 1;

    CpuState saved_cpu = g_cpu;
    static uint8 saved_ram[0x20000];
    memcpy(saved_ram, g_ram, sizeof(saved_ram));
    for (int off = -512; off <= 512; off += 8) {
        memcpy(g_ram, saved_ram, sizeof(saved_ram));
        g_cpu = saved_cpu;
        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
        RecompReturn r = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
        int nonblank = 0;
        for (int i = 0; i < 10; i++)
            if (WsRead16((uint16)(0x0230 + i * 2)) != 0x00A0) nonblank++;
        fprintf(stderr, "[ws2scan] off=%d ret=%d nonblank=%d "
                        "0230=%04x 0232=%04x 0234=%04x 0236=%04x "
                        "0238=%04x 023a=%04x 0260=%04x 0262=%04x "
                        "0264=%04x 0266=%04x\n",
                off, (int)r, nonblank, WsRead16(0x0230), WsRead16(0x0232),
                WsRead16(0x0234), WsRead16(0x0236), WsRead16(0x0238),
                WsRead16(0x023A), WsRead16(0x0260), WsRead16(0x0262),
                WsRead16(0x0264), WsRead16(0x0266));
        fflush(stderr);
    }
    memcpy(g_ram, saved_ram, sizeof(saved_ram));
    g_cpu = saved_cpu;
}

/* Test-only 2D scan over world x/y offsets through stage 2. */
static void WsTestStage2Scan2(void)
{
    static int done;
    const char *enable = getenv("SNESRECOMP_WS_TEST_STAGE2_SCAN2");
    if (done || !enable || !*enable || !InLiveRace()) return;
    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
    int trigger = frame_env && *frame_env ? atoi(frame_env) : 3504;
    if (snes_frame_counter < trigger) return;
    done = 1;

    CpuState saved_cpu = g_cpu;
    static uint8 saved_ram[0x20000];
    memcpy(saved_ram, g_ram, sizeof(saved_ram));
    for (int oy = -256; oy <= 256; oy += 64) {
        for (int ox = -512; ox <= 512; ox += 64) {
            memcpy(g_ram, saved_ram, sizeof(saved_ram));
            g_cpu = saved_cpu;
            WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + ox));
            WsWrite16(0x00A7, (uint16)(WsRead16(0x00A7) + oy));
            RecompReturn r = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
            int nonblank = 0;
            for (int i = 0; i < 10; i++)
                if (WsRead16((uint16)(0x0230 + i * 2)) != 0x00A0) nonblank++;
            if (nonblank)
                fprintf(stderr, "[ws2scan2] ox=%d oy=%d ret=%d nonblank=%d "
                                "0230=%04x 0232=%04x 0234=%04x 0236=%04x "
                                "0238=%04x 0260=%04x 0262=%04x 0264=%04x "
                                "0266=%04x\n",
                        ox, oy, (int)r, nonblank, WsRead16(0x0230),
                        WsRead16(0x0232), WsRead16(0x0234), WsRead16(0x0236),
                        WsRead16(0x0238), WsRead16(0x0260), WsRead16(0x0262),
                        WsRead16(0x0264), WsRead16(0x0266));
            fflush(stderr);
        }
    }
    memcpy(g_ram, saved_ram, sizeof(saved_ram));
    g_cpu = saved_cpu;
}

