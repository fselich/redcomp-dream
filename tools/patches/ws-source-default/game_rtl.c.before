/* Test-only: try scroll/world-state candidates as the horizontal key. */
static void WsTestStage2Keys(void)
{
    static int done;
    const char *enable = getenv("SNESRECOMP_WS_TEST_STAGE2_KEYS");
    if (done || !enable || !*enable || !InLiveRace()) return;
    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
    int trigger = frame_env && *frame_env ? atoi(frame_env) : 3504;
    if (snes_frame_counter < trigger) return;
    done = 1;
    CpuState saved_cpu = g_cpu;
    static uint8 saved_ram[0x20000];
    memcpy(saved_ram, g_ram, sizeof(saved_ram));
    const uint16 addrs[2] = {0x041D, 0x041F};
    for (int a = 0; a < 2; a++) {
        for (int off = -256; off <= 256; off += 64) {
            memcpy(g_ram, saved_ram, sizeof(saved_ram));
            g_cpu = saved_cpu;
            WsWrite16(0x00A7, (uint16)(WsRead16(0x00A7) + 64));
            WsWrite16(addrs[a], (uint16)(WsRead16(addrs[a]) + off));
            RecompReturn r = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
            int nonblank = 0;
            for (int i = 0; i < 10; i++)
                if (WsRead16((uint16)(0x0230 + i * 2)) != 0x00A0) nonblank++;
            fprintf(stderr, "[ws2key] addr=%04x off=%d ret=%d nonblank=%d "
                            "0230=%04x 0232=%04x 0234=%04x 0236=%04x "
                            "0260=%04x 0262=%04x\n",
                    addrs[a], off, (int)r, nonblank, WsRead16(0x0230),
                    WsRead16(0x0232), WsRead16(0x0234), WsRead16(0x0236),
                    WsRead16(0x0260), WsRead16(0x0262));
            fflush(stderr);
        }
    }
    memcpy(g_ram, saved_ram, sizeof(saved_ram));
    g_cpu = saved_cpu;
}

void GameRunOneFrame(void)
{
    WsApplyCull();
    snes_beam_frame_driver_run_frame();
    WsTestGen();
    WsTestStage2();
    WsTestStage2Scan();
    WsTestStage2Scan2();
    WsTestStage2Scan3();
    WsTestStage2Scan4();
    WsTestStage2Keys();
    /* Catch a base written during this frame before the next cull pass. */
    WsApplyCull();
}

/* Test-only edge-repeat presentation. The 32x32 BG1 ring is sampled by the
 * margins through the opposite map columns; copy the visible edge columns into
 * those ring slots before rasterization and restore afterwards. This is not a
 * source-backed fill: it is a visual experiment for horizontal sections. */
#define WS_REPEAT_COLS 6
static uint16 s_repeat_save[2][WS_REPEAT_COLS][32];
static uint8 s_repeat_saved;

static int WsTrackRepeatEnabled(void)
{
    const char *e = getenv("SNESRECOMP_WS_TRACK_REPEAT");
    return e && *e && strcmp(e, "0") != 0;
}

static void WsRepeatBegin(Ppu *ppu)
{
    if (!ppu || s_repeat_saved) return;
    uint16 base = (uint16)((ppu->bgXsc[0] & 0xFC) << 8);
    int start = (ppu->hScroll[0] >> 3) & 31;
    int left_edge = start & 31;
    int right_edge = (start + 31) & 31;
    for (int side = 0; side < 2; side++) {
        for (int i = 0; i < WS_REPEAT_COLS; i++) {
            int col = side == 0 ? (start - 1 - i) & 31
                                : (start + 32 + i) & 31;
            int src = side == 0 ? left_edge : right_edge;
            for (int y = 0; y < 32; y++) {
                s_repeat_save[side][i][y] =
                    ppu->vram[base + y * 32 + col];
                ppu->vram[base + y * 32 + col] =
                    ppu->vram[base + y * 32 + src];
            }
        }
    }
    s_repeat_saved = 1;
}

static void WsRepeatEnd(Ppu *ppu)
{
    if (!ppu || !s_repeat_saved) return;
    uint16 base = (uint16)((ppu->bgXsc[0] & 0xFC) << 8);
    int start = (ppu->hScroll[0] >> 3) & 31;
    for (int side = 0; side < 2; side++) {
        for (int i = 0; i < WS_REPEAT_COLS; i++) {
            int col = side == 0 ? (start - 1 - i) & 31
                                : (start + 32 + i) & 31;
            for (int y = 0; y < 32; y++)
                ppu->vram[base + y * 32 + col] =
                    s_repeat_save[side][i][y];
        }
    }
    s_repeat_saved = 0;
}

/* Test-only prototype: per-cell verified BG1 ring margins.
 *
 * The ring already holds authentic world cells on the trailing margin. The
 * leading margin holds cells last written a full ring (512 px) earlier. Track
 * a 32x32 "seen" table from the native view (world cell + tile word) and let
 * the renderer substitute a transparent entry for every margin cell that does
 * not match it. This runs inside PpuDrawBackgroundBig, so it never writes
 * guest VRAM: a host-side bracket would also hit the HUD, which uses a
 * different map base in its scanline bands. See
 * openspec/changes/uniracers-ws-leading-edge (Option A). */
#define WS_OW_CELLS 32
/* The raster walk names visible output rows 1..224 (renderBuffer uses y-1). */
#define WS_OW_LINE_FIRST 1
#define WS_OW_LINE_LAST 224

typedef struct {
    int32_t wx, wy;
    uint16_t tile;
    uint8_t valid;
    int frame;      /* snes_frame_counter of the last native observation */
} WsOwSeen;

static WsOwSeen s_ow_seen[WS_OW_CELLS][WS_OW_CELLS];
static uint8_t s_ow_logged[WS_OW_CELLS][WS_OW_CELLS];
static unsigned s_ow_scene_generation;

typedef struct {
    int32_t wx, wy;
    uint16_t tile;
    uint8_t valid;
} WsGhostCell;

static WsGhostCell s_gh[WS_OW_CELLS][WS_OW_CELLS];
static int s_gh_valid;
static int32_t s_ow_unwrapped_h, s_ow_unwrapped_v;
static uint16_t s_ow_prev_h, s_ow_prev_v;
static int s_ow_scroll_valid;

static int s_ow_frame_active;
static int32_t s_ow_base_h, s_ow_base_v;
static uint16_t s_ow_frame_raw_h, s_ow_frame_raw_v;
static uint16_t s_ow_map_base;
static uint16_t s_ow_prev_map_base;
static uint8_t s_ow_prev_bgmode;
static int s_ow_scene_valid;
static uint16_t s_ow_mask_word = 0xFFFF;
static FILE *s_ow_log;
static int s_ow_announced;
static int s_ow_live_prev = -1;

static int WsOffwindowMode(void)
{
    static int mode = -2;
    if (mode == -2) {
        const char *e = getenv("SNESRECOMP_WS_OFFWINDOW");
        if (!e || !*e || strcmp(e, "0") == 0) mode = 0;
        else if (strcmp(e, "ring") == 0) mode = 1;
        else if (strcmp(e, "source") == 0) mode = 2;
        else if (strcmp(e, "ghost") == 0) mode = 3;
        else mode = 0;
    }
    return mode;
}

static int32_t WsOwFloor16(int64_t v)
{
    return (int32_t)(v >= 0 ? v / 16 : -(((-v) + 15) / 16));
}

static int WsOwMod16(int64_t v)
{
    int m = (int)(v % 16);
    return m < 0 ? m + 16 : m;
}

static uint16_t WsOwMapAddrBase(int cx, int cy)
{
    return (uint16_t)((s_ow_map_base + ((cy & 31) << 5) + (cx & 31)) & 0x7FFF);
}

static void WsOwReset(void)
{
    memset(s_ow_seen, 0, sizeof(s_ow_seen));
    s_ow_scroll_valid = 0;
    s_ow_frame_active = 0;
}

static void WsOwLogVisit(int cx, int cy, int32_t wx, int32_t wy,
                         uint16_t real, uint16_t served, int masked)
{
    const char *path = getenv("SNESRECOMP_WS_OFFWINDOW_LOG");
    if (!path || !*path) return;
    if (!s_ow_log) {
        s_ow_log = fopen(path, "w");
        if (!s_ow_log) return;
        fprintf(s_ow_log, "# frame,cell_x,cell_y,world_x,world_y,real,mask,"
                          "masked\n");
    }
    fprintf(s_ow_log, "%d,%d,%d,%d,%d,0x%04x,0x%04x,%d\n",
            snes_frame_counter, cx, cy, wx, wy, real, served, masked);
}

/* Find a 16x16 character whose four 8x8 sub-characters are all zero words:
 * pixel 0 in every position, so a map word pointing at it is transparent for
 * any palette/priority. Returns the character index or -1. */
static int WsOwFindBlankChar(Ppu *ppu)
{
    int tileadr = PPU_bgTileAdr(ppu, 0);
    for (int c = 0; c <= 1023 - 17; c++) {
        int ok = 1;
        for (int q = 0; q < 4 && ok; q++) {
            int ch = c + (q & 1) + ((q >> 1) << 4);
            int off = (tileadr + ch * 16) & 0x7FFF;
            for (int i = 0; i < 16; i++) {
                if (ppu->vram[(off + i) & 0x7FFF]) { ok = 0; break; }
            }
        }
        if (ok) return c;
    }
    return -1;
}

static void WsOwUpdateScroll(uint16_t raw_h, uint16_t raw_v)
{
    if (!s_ow_scroll_valid) {
        s_ow_unwrapped_h = raw_h;
        s_ow_unwrapped_v = raw_v;
        s_ow_scroll_valid = 1;
    } else {
        int dh = (int)((raw_h - s_ow_prev_h) & 0x3FF);
        int dv = (int)((raw_v - s_ow_prev_v) & 0x3FF);
        if (dh >= 512) dh -= 1024;
        if (dv >= 512) dv -= 1024;
        s_ow_unwrapped_h += dh;
        s_ow_unwrapped_v += dv;
    }
    s_ow_prev_h = raw_h;
    s_ow_prev_v = raw_v;
}

/* Absolute scroll for the line currently being rasterized, from the frame's
 * line-1 base plus that line's own register value. Handles per-line changes
 * without assuming the whole field shares one scroll. */
static void WsOwLineScroll(Ppu *ppu, int line, int32_t *h, int32_t *v)
{
    int dh = (int)((ppu->hScroll[0] - s_ow_frame_raw_h) & 0x3FF);
    int dv = (int)((ppu->vScroll[0] - s_ow_frame_raw_v) & 0x3FF);
    if (dh >= 512) dh -= 1024;
    if (dv >= 512) dv -= 1024;
    *h = s_ow_base_h + dh;
    *v = s_ow_base_v + dv;
    (void)line;
}

/* Record every ring cell the native view shows on this line. Called before the
 * line is drawn, so boundary cells shared with a margin are already valid. */
static void WsOwObserveLine(Ppu *ppu, int line)
{
    int32_t h, v;
    WsOwLineScroll(ppu, line, &h, &v);
    int64_t sy = (int64_t)v + line;
    int32_t wy = WsOwFloor16(sy);
    int cy = wy & 31;
    int x = 0;
    while (x < 256) {
        int64_t sx = (int64_t)h + x;
        int32_t wx = WsOwFloor16(sx);
        int cx = wx & 31;
        WsOwSeen *s = &s_ow_seen[cy][cx];
        s->wx = wx;
        s->wy = wy;
        s->tile = ppu->vram[WsOwMapAddrBase(cx, cy)];
        s->valid = 1;
        s->frame = snes_frame_counter;
        x += 16 - WsOwMod16(sx);
    }
}

/* Per-line host hook (beam_frame_driver) run after the journal and HDMA for
 * this line, before it is drawn. */
static void WsOffwindowLine(Ppu *ppu, unsigned line, void *context)
{
    (void)context;
    if (!ppu) return;
    if ((int)line == WS_OW_LINE_FIRST) {
        uint16_t map_base = PPU_bgTilemapAdr(ppu, 0);
        uint8_t mode = ppu->bgmode;
        /* NOW PLAYING (mode 3, base 0) can already satisfy InLiveRace. Do not
         * carry its seen entries or scroll unwrap into the race. */
        if (!s_ow_scene_valid || map_base != s_ow_prev_map_base ||
            mode != s_ow_prev_bgmode) {
            WsOwReset();
            s_ow_scene_generation++;
            s_ow_scene_valid = 1;
            s_ow_prev_map_base = map_base;
            s_ow_prev_bgmode = mode;
            fprintf(stderr, "[ws-ow] scene reset: base=%04x mode=%02x "
                            "scroll=%u,%u\n", map_base, mode,
                    ppu->hScroll[0], ppu->vScroll[0]);
        }
        memset(s_ow_logged, 0, sizeof(s_ow_logged));
        s_ow_mask_word = 0xFFFF;
        int blank = WsOwFindBlankChar(ppu);
        if (blank >= 0) s_ow_mask_word = (uint16_t)(blank & 0x3FF);
        WsOwUpdateScroll(ppu->hScroll[0], ppu->vScroll[0]);
        s_ow_base_h = s_ow_unwrapped_h;
        s_ow_base_v = s_ow_unwrapped_v;
        s_ow_frame_raw_h = ppu->hScroll[0];
        s_ow_frame_raw_v = ppu->vScroll[0];
        s_ow_map_base = map_base;
        s_ow_frame_active = 1;
        if (!s_ow_announced) {
            s_ow_announced = 1;
            fprintf(stderr, "[ws-ow] active: mode=%d map_base=%04x "
                            "scroll=%u,%u extra=%d/%d\n",
                    WsOffwindowMode(), s_ow_map_base, s_ow_frame_raw_h,
                    s_ow_frame_raw_v, ppu->extraLeftCur, ppu->extraRightCur);
        }
    }
    if (!s_ow_frame_active) return;
    WsOwObserveLine(ppu, (int)line);
}

/* ── Track-table source (SNESRECOMP_WS_OFFWINDOW=source) ──────────────────
 *
 * The whole track is in WRAM bank $7F from load to finish (RNC1-unpacked by
 * $81:B8F1): a u16 piece-id grid at $7F:000F (cols x rows, 0x8000 bytes) and
 * a library of 4x4-cell pieces at $7F:800F. See docs/UNIRACERS_TRACK_FORMAT.md.
 * Margin cells that Option A cannot verify are read from that table at
 * world + anchor. The anchor (table cell - world key, constant per race) is
 * searched from the verified native cells and re-checked every frame; while
 * it is invalid the margins are masked exactly as in `ring` mode.
 * Ring cells that read 0x0000 are never used as evidence: at race start the
 * game leaves some ring cells unwritten (they show 0x0000 natively for a few
 * frames), so they say nothing about the table. Nor are words that occur
 * nowhere in the piece library (the race-start overlay draws such words into
 * the ring). The search uses every verified cell still in the seen table, not
 * only this frame's: the map is static, so older observations stay true and
 * their wider footprint resolves repetitive geometry (Switcher). The
 * self-check uses this frame's cells only. Repeated sections can leave a few
 * equally good anchors; up to WS_SRC_MAX_ANCHORS are kept and a margin cell is
 * served only where all of them give the same word (the self-check prunes
 * them as the camera moves on). Presentation-only: reads
 * g_ram, writes nothing. openspec/changes/uniracers-ws-source. */
#define WS_SRC_MIN_SAMPLES 8
#define WS_SRC_MAX_SAMPLES 256
#define WS_SRC_CHECK_SAMPLES 32
#define WS_SRC_MAX_CANDIDATES 4096
#define WS_SRC_MAX_PIECES 2048
#define WS_SRC_MAX_ANCHORS 8

typedef struct {
    int32_t wx, wy;
    uint16_t tile;
} WsSrcSample;

static int s_src_valid;                      /* number of live anchors */
static int32_t s_src_ax[WS_SRC_MAX_ANCHORS], s_src_ay[WS_SRC_MAX_ANCHORS];
static int s_src_cols, s_src_rows;          /* grid size in cells */
static unsigned s_src_generation;
static int s_src_race_frame0 = -1;          /* first live frame of this scene */
static uint64_t s_src_served, s_src_check_fail, s_src_anchors;
static uint8_t s_src_word_present[0x10000 / 8];  /* words in the piece library */
static uint16_t s_src_present_end;              /* library end it was built for */
static FILE *s_src_log;

static void WsSrcLog(const char *fmt, ...)
{
    const char *path = getenv("SNESRECOMP_WS_SOURCE_LOG");
    if (!path || !*path) return;
    if (!s_src_log) {
        s_src_log = fopen(path, "w");
        if (!s_src_log) return;
    }
    va_list ap;
    va_start(ap, fmt);
    vfprintf(s_src_log, fmt, ap);
    va_end(ap);
    fflush(s_src_log);
}

static uint16_t WsSrcRead16(uint32_t off)
{
    return (uint16_t)(g_ram[0x10000 + off] | (g_ram[0x10000 + off + 1] << 8));
}

/* Grid dimensions from the unpacked header: $7F:000D = cols/4, $7F:000E =
 * rows/4 (0 means 256). The id grid is always 0x8000 bytes. */
static int WsSrcHeader(void)
{
    int cb = (g_ram[0x1000D] ? g_ram[0x1000D] : 256);
    int rb = (g_ram[0x1000E] ? g_ram[0x1000E] : 256);
    int cols = cb * 4, rows = rb * 4;               /* blocks */
    if (cols * rows * 2 != 0x8000) return 0;
    s_src_cols = cols * 4;
    s_src_rows = rows * 4;
    /* Library end ($7F:000B-000C, rewritten by the game at load). Rebuild the
     * word-presence set when it changes (new track). */
    uint16_t end = WsSrcRead16(0x000B);
    if (end != s_src_present_end) {
        s_src_present_end = end;
        memset(s_src_word_present, 0, sizeof(s_src_word_present));
        uint32_t lim = end > 0x800F ? end : 0xFFFE;
        for (uint32_t off = 0x800F; off + 1 < lim && off + 1 <= 0xFFFF; off += 2) {
            uint16_t w = WsSrcRead16(off);
            s_src_word_present[w >> 3] |= (uint8_t)(1u << (w & 7));
        }
    }
    return 1;
}

static int WsSrcWordUsable(uint16_t w)
{
    return w && (s_src_word_present[w >> 3] & (1u << (w & 7)));
}

/* Table word for table cell (tx, ty). Outside the grid the game shows
 * 0x0000. Returns 0 only for an id pointing past the bank. */
static int WsSrcCell(int32_t tx, int32_t ty, uint16_t *out)
{
    if (tx < 0 || ty < 0 || tx >= s_src_cols || ty >= s_src_rows) {
        *out = 0;
        return 1;
    }
    uint32_t id = WsSrcRead16(0x000F + 2u * ((uint32_t)(ty >> 2) *
                                             (uint32_t)(s_src_cols >> 2) +
                                             (uint32_t)(tx >> 2)));
    uint32_t off = 0x800F + id * 32u + (uint32_t)(ty & 3) * 8u +
                   (uint32_t)(tx & 3) * 2u;
    if (off + 1 > 0xFFFF) return 0;
    *out = WsSrcRead16(off);
    return 1;
}

/* Verified native cells usable as evidence: this frame's only, or every cell
 * still held in the seen table (all_frames). */
static int WsSrcSamples(WsSrcSample *out, int max, int all_frames)
{
    int n = 0;
    for (int cy = 0; cy < WS_OW_CELLS && n < max; cy++) {
        for (int cx = 0; cx < WS_OW_CELLS && n < max; cx++) {
            const WsOwSeen *s = &s_ow_seen[cy][cx];
            if (!s->valid || !WsSrcWordUsable(s->tile))
                continue;
            if (!all_frames && s->frame != snes_frame_counter)
                continue;
            out[n].wx = s->wx;
            out[n].wy = s->wy;
            out[n].tile = s->tile;
            n++;
        }
    }
    return n;
}

static int WsSrcAgreement(const WsSrcSample *smp, int n, int32_t ax,
                          int32_t ay, int max_miss)
{
    int ok = 0, miss = 0;
    for (int i = 0; i < n; i++) {
        uint16_t w;
        if (WsSrcCell(smp[i].wx + ax, smp[i].wy + ay, &w) && w == smp[i].tile)
            ok++;
        else if (++miss > max_miss)
            return -1;
    }
    return ok;
}

/* Find the unique anchor matching >= 95 % of this frame's verified cells.
 * Seeds from the rarest sampled word; candidate positions come from a
 * per-piece index of where that word occurs. */
static void WsSrcSearch(void)
{
    static WsSrcSample smp[WS_SRC_MAX_SAMPLES];
    static uint16_t piece_mask[WS_SRC_MAX_PIECES];
    if (!WsSrcHeader()) return;
    int n = WsSrcSamples(smp, WS_SRC_MAX_SAMPLES, 1);
    if (n < WS_SRC_MIN_SAMPLES) {
        if (snes_frame_counter % 30 == 0)
            WsSrcLog("%d anchor wait samples=%d\n", snes_frame_counter, n);
        return;
    }
    int max_miss = n / 20;                       /* >= 95 % agreement */

    /* Try seeds from rarest to commonest word (at most four distinct). */
    int tried = 0;
    uint16_t tried_words[4];
    clock_t t0 = clock();
    while (tried < 4) {
        int seed = -1, seed_count = 0x7FFFFFFF;
        for (int i = 0; i < n; i++) {
            int skip = 0;
            for (int k = 0; k < tried; k++)
                if (tried_words[k] == smp[i].tile) skip = 1;
            if (skip) continue;
            int c = 0;
            for (int j = 0; j < n; j++) c += smp[j].tile == smp[i].tile;
            if (c < seed_count) { seed_count = c; seed = i; }
        }
        if (seed < 0) break;
        uint16_t word = smp[seed].tile;
        tried_words[tried++] = word;

        /* Which positions inside each piece hold the seed word. */
        uint32_t pieces = (0x10000u - 0x800Fu) / 32u;
        if (pieces > WS_SRC_MAX_PIECES) pieces = WS_SRC_MAX_PIECES;
        for (uint32_t id = 0; id < pieces; id++) {
            uint16_t m = 0;
            for (int k = 0; k < 16; k++)
                if (WsSrcRead16(0x800F + id * 32u + (uint32_t)k * 2u) == word)
                    m |= (uint16_t)(1u << k);
            piece_mask[id] = m;
        }
        int bcols = s_src_cols >> 2, brows = s_src_rows >> 2;
        int candidates = 0, survivors = 0;
        int32_t sur_ax[WS_SRC_MAX_ANCHORS], sur_ay[WS_SRC_MAX_ANCHORS];
        for (int by = 0; by < brows && candidates <= WS_SRC_MAX_CANDIDATES; by++) {
            for (int bx = 0; bx < bcols; bx++) {
                uint32_t id = WsSrcRead16(0x000F + 2u * (uint32_t)(by * bcols + bx));
                if (id >= pieces || !piece_mask[id]) continue;
                for (int k = 0; k < 16; k++) {
                    if (!(piece_mask[id] & (1u << k))) continue;
                    candidates++;
                    int32_t ax = bx * 4 + (k & 3) - smp[seed].wx;
                    int32_t ay = by * 4 + (k >> 2) - smp[seed].wy;
                    if (WsSrcAgreement(smp, n, ax, ay, max_miss) < 0) continue;
                    int dup = 0;
                    for (int i = 0; i < survivors && i < WS_SRC_MAX_ANCHORS; i++)
                        if (sur_ax[i] == ax && sur_ay[i] == ay) dup = 1;
                    if (dup) continue;
                    if (survivors < WS_SRC_MAX_ANCHORS) {
                        sur_ax[survivors] = ax;
                        sur_ay[survivors] = ay;
                    }
                    survivors++;
                }
            }
        }
        if (candidates > WS_SRC_MAX_CANDIDATES) continue;   /* too common */
        double ms = 1000.0 * (double)(clock() - t0) / CLOCKS_PER_SEC;
        if (survivors >= 1 && survivors <= WS_SRC_MAX_ANCHORS) {
            for (int i = 0; i < survivors; i++) {
                s_src_ax[i] = sur_ax[i];
                s_src_ay[i] = sur_ay[i];
            }
            s_src_valid = survivors;
            s_src_anchors++;
            WsSrcLog("%d anchor ok ax=%d ay=%d anchors=%d grid=%dx%d samples=%d "
                     "seed=%04x candidates=%d latency=%d search_ms=%.3f\n",
                     snes_frame_counter, sur_ax[0], sur_ay[0], survivors,
                     s_src_cols, s_src_rows, n, word, candidates,
                     s_src_race_frame0 >= 0 ? snes_frame_counter - s_src_race_frame0 : -1,
                     ms);
            return;
        }
        WsSrcLog("%d anchor retry seed=%04x candidates=%d survivors=%d "
                 "search_ms=%.3f\n", snes_frame_counter, word, candidates,
                 survivors, ms);
        if (survivors > 0) return;      /* too ambiguous: wait for the camera */
    }
}

/* After each drawn frame: keep, verify or (re)establish the anchor. */
static void WsSrcFrame(void)
{
    if (s_src_generation != s_ow_scene_generation) {
        s_src_generation = s_ow_scene_generation;
        if (s_src_valid)
            WsSrcLog("%d anchor dropped: scene reset\n", snes_frame_counter);
        s_src_valid = 0;
        s_src_race_frame0 = snes_frame_counter;
    }
    if (!s_src_valid) {
        WsSrcSearch();
        return;
    }
    if (!WsSrcHeader()) {
        s_src_valid = 0;
        WsSrcLog("%d anchor dropped: header invalid\n", snes_frame_counter);
        return;
    }
    WsSrcSample smp[WS_SRC_CHECK_SAMPLES];
    int n = WsSrcSamples(smp, WS_SRC_CHECK_SAMPLES, 0);
    if (n == 0) return;
    int kept = 0, before = s_src_valid;
    for (int i = 0; i < s_src_valid; i++) {
        int ok = WsSrcAgreement(smp, n, s_src_ax[i], s_src_ay[i], n);
        if (ok * 20 < n * 19) {
            WsSrcLog("%d anchor (%d,%d) dropped: self-check %d/%d\n",
                     snes_frame_counter, s_src_ax[i], s_src_ay[i], ok, n);
            continue;
        }
        if (ok != n)
            WsSrcLog("%d self-check (%d,%d) %d/%d\n", snes_frame_counter,
                     s_src_ax[i], s_src_ay[i], ok, n);
        s_src_ax[kept] = s_src_ax[i];
        s_src_ay[kept] = s_src_ay[i];
        kept++;
    }
    s_src_valid = kept;
    if (!kept) {
        s_src_check_fail++;
        WsSrcLog("%d anchor dropped: no anchor passes the self-check\n",
                 snes_frame_counter);
    } else if (kept != before && kept == 1) {
        WsSrcLog("%d anchor resolved ax=%d ay=%d\n", snes_frame_counter,
                 s_src_ax[0], s_src_ay[0]);
    }
}

static void WsSrcInvalidate(void)
{
    if (s_src_valid)
        WsSrcLog("%d anchor dropped: race not live\n", snes_frame_counter);
    s_src_valid = 0;
}

/* Renderer hook: decide the tile word for a margin sample of BG1. The map
 * address is checked against the race BG1 ring so HUD bands that repoint the
 * layer's map base are left alone. */
static uint16_t WsOffwindowTile(Ppu *ppu, unsigned layer, int screen_x,
                                int line, uint16_t tile, uint16_t sc,
                                void *context)
{
    (void)context;
    if (!s_ow_frame_active || layer != 0) return tile;
    if (screen_x >= 0 && screen_x < 256) return tile;

    int32_t h, v;
    WsOwLineScroll(ppu, line, &h, &v);
    int32_t wx = WsOwFloor16((int64_t)h + screen_x);
    int32_t wy = WsOwFloor16((int64_t)v + line);
    int cx = wx & 31, cy = wy & 31;
    if ((sc & 0x7FFF) != WsOwMapAddrBase(cx, cy)) return tile;

    WsOwSeen *s = &s_ow_seen[cy][cx];
    if (s->valid && s->wx == wx && s->wy == wy && s->tile == tile)
        return tile;

    if (WsOffwindowMode() == 2 && s_src_valid) {
        uint16_t w;
        int agree = WsSrcCell(wx + s_src_ax[0], wy + s_src_ay[0], &w);
        for (int i = 1; agree && i < s_src_valid; i++) {
            uint16_t wi;
            agree = WsSrcCell(wx + s_src_ax[i], wy + s_src_ay[i], &wi) && wi == w;
        }
        if (agree) {
            s_src_served++;
            if (!s_ow_logged[cy][cx]) {
                s_ow_logged[cy][cx] = 1;
                WsOwLogVisit(cx, cy, wx, wy, tile, w, 0);
            }
            return w;
        }
    }

    if (WsOffwindowMode() == 3 && s_gh_valid) {
        WsGhostCell *g = &s_gh[cy][cx];
        if (g->valid && g->wx == wx && g->wy == wy) {
            if (!s_ow_logged[cy][cx]) {
                s_ow_logged[cy][cx] = 1;
                WsOwLogVisit(cx, cy, wx, wy, tile, g->tile, 0);
            }
            return g->tile;
        }
    }

    int masked = s_ow_mask_word != 0xFFFF;
    if (!s_ow_logged[cy][cx]) {
        s_ow_logged[cy][cx] = 1;
        WsOwLogVisit(cx, cy, wx, wy, tile, masked ? s_ow_mask_word : tile,
                     masked);
    }
    return masked ? s_ow_mask_word : tile;
}


/* ── Ghost lane (SNESRECOMP_WS_OFFWINDOW=ghost) ───────────────────────────
 *
 * A speculative machine runs ahead of the real one. Its BG1 ring cells are
 * harvested into s_gh with the same world-key + tile-word rule as Option A,
 * and served only when the real margin needs exactly that world cell. The
 * level map is static per world cell, so a cell the game writes in a
 * speculative future is still correct for that cell.
 *
 * The lane does not touch the real machine: save the rollback blob and the
 * host render state, run the ghost, save its blob, load the real blob and
 * restore the host state before the real field is drawn. */
#define WS_GHOST_SENTINEL (INT_MIN / 2)

static int s_gh_frame_active;
static int s_gh_scene_ok;
static int32_t s_gh_unwrapped_h, s_gh_unwrapped_v;
static uint16_t s_gh_prev_h, s_gh_prev_v;
static int s_gh_scroll_valid;
static int32_t s_gh_base_h, s_gh_base_v;
static uint16_t s_gh_frame_raw_h, s_gh_frame_raw_v;
static uint16_t s_gh_map_base;

static uint8_t *s_gh_blob, *s_re_blob;
static size_t s_gh_cap, s_re_cap, s_gh_len, s_re_len;
static int s_ghost_valid;
static int s_ghost_lead;
static int s_ghost_input_valid;
static uint32_t s_ghost_input;
static unsigned s_ghost_scene_gen;
static int s_ghost_frames_since_resync;
static uint32_t s_ghost_pc;
static bool s_ghost_wai;
static WsCullState s_ghost_cull;
static void *s_raster_save;
static size_t s_raster_save_size;
static int s_ghost_in_hook;
static int s_ghost_announced;
static int s_ghost_warned;
static uint32_t s_gh_chr_hash;
static int s_gh_chr_has;
static int s_gh_chr_stable;
static int s_gh_chr_ready;
#define WS_GHOST_CHR_WARMUP 30
static Ppu s_ghost_ppu_save;

static int WsGhostEnvInt(const char *name, int def, int lo, int hi)
{
    const char *e = getenv(name);
    int v = e && *e ? atoi(e) : def;
    if (v < lo) v = lo;
    if (v > hi) v = hi;
    return v;
}

static int WsGhostAhead(void)
{
    return WsGhostEnvInt("SNESRECOMP_WS_GHOST_AHEAD", 4, 0, 8);
}

static int WsGhostMaxSteps(void)
{
    return WsGhostEnvInt("SNESRECOMP_WS_GHOST_MAXSTEPS", 2, 1, 8);
}

static int WsGhostResync(void)
{
    return WsGhostEnvInt("SNESRECOMP_WS_GHOST_RESYNC", 600, 1, 3600);
}

static int WsGhostEligible(void)
{
    if (WsOffwindowMode() != 3) return 0;
    if (!WideEnabled() || !InLiveRace()) return 0;
    if (snes_runahead_frames() > 0) return 0;
    if (snes_netplay_active()) return 0;
    return 1;
}

static int WsGhostEnsureBuffers(void)
{
    size_t bound = RtlRollbackSnapshotBound();
    if (!bound) return 0;

    if (!s_gh_blob || s_gh_cap < bound) {
        uint8_t *p = (uint8_t *)realloc(s_gh_blob, bound);
        if (!p) return 0;
        s_gh_blob = p;
        s_gh_cap = bound;
        s_ghost_valid = 0;
    }
    if (!s_re_blob || s_re_cap < bound) {
        uint8_t *p = (uint8_t *)realloc(s_re_blob, bound);
        if (!p) return 0;
        s_re_blob = p;
        s_re_cap = bound;
    }
    if (!s_raster_save) {
        size_t n = ppu_rasterStateSize();
        if (!n) return 0;
        s_raster_save = malloc(n);
        if (!s_raster_save) return 0;
        s_raster_save_size = n;
    }
    return 1;
}

static void WsGhostSeedScroll(void)
{
    if (!s_ow_scroll_valid) {
        s_gh_scroll_valid = 0;
        return;
    }
    s_gh_scroll_valid = 1;
    s_gh_unwrapped_h = s_ow_unwrapped_h;
    s_gh_unwrapped_v = s_ow_unwrapped_v;
    s_gh_prev_h = s_ow_prev_h;
    s_gh_prev_v = s_ow_prev_v;
}

static int WsGhostWrapDelta(uint16_t now, uint16_t prev)
{
    int d = (int)((now - prev) & 0x3FF);
    return d >= 512 ? d - 1024 : d;
}

/* BG1 character data is streamed at race/scene entry. A ghost map word is
 * only safe to draw while the real lane's character region has been stable
 * for a short window; otherwise it could point at a character the real VRAM
 * has not received yet. The hash is cheap and also feeds the optional trace. */
static void WsGhostChrCheck(void)
{
    if (!g_ppu) return;
    const char *path = getenv("SNESRECOMP_WS_GHOST_CHR_LOG");
    static FILE *f;
    if (path && *path && !f) {
        f = fopen(path, "w");
        if (f) fprintf(f, "# frame,hash,nonzero\n");
    }
    int base = PPU_bgTileAdr(g_ppu, 0);
    uint32_t h = 2166136261u;
    int nonzero = 0;
    for (int i = 0; i < 0x4000; i++) {
        uint16_t w = g_ppu->vram[(base + i) & 0x7FFF];
        if (w) nonzero++;
        h ^= w & 0xFF;
        h *= 16777619u;
        h ^= w >> 8;
        h *= 16777619u;
    }
    if (!s_gh_chr_has || h != s_gh_chr_hash) {
        s_gh_chr_hash = h;
        s_gh_chr_has = 1;
        s_gh_chr_stable = 0;
        s_gh_chr_ready = 0;
        if (f) {
            fprintf(f, "%d,0x%08x,%d\n", snes_frame_counter, h, nonzero);
            fflush(f);
        }
    } else if (s_gh_chr_stable < WS_GHOST_CHR_WARMUP) {
        s_gh_chr_stable++;
        if (s_gh_chr_stable >= WS_GHOST_CHR_WARMUP) s_gh_chr_ready = 1;
    }
}

static void WsGhostLine(Ppu *ppu, unsigned line, void *context)
{
    (void)context;
    if (!ppu || !s_gh_frame_active || !s_gh_scene_ok) return;

    if ((int)line == WS_OW_LINE_FIRST) {
        uint16_t base = PPU_bgTilemapAdr(ppu, 0);
        uint8_t mode = ppu->bgmode;
        /* The real lane's scene is the last one it drew. A ghost frame in a
         * transition is not useful; drop the harvest until the real draw
         * catches up. */
        if (!s_ow_scene_valid || base != s_ow_map_base ||
            mode != s_ow_prev_bgmode || !s_gh_scroll_valid) {
            s_gh_scene_ok = 0;
            s_gh_valid = 0;
            return;
        }
        s_gh_map_base = base;
        int dh = WsGhostWrapDelta(ppu->hScroll[0], s_gh_prev_h);
        int dv = WsGhostWrapDelta(ppu->vScroll[0], s_gh_prev_v);
        s_gh_unwrapped_h += dh;
        s_gh_unwrapped_v += dv;
        s_gh_prev_h = ppu->hScroll[0];
        s_gh_prev_v = ppu->vScroll[0];
        s_gh_base_h = s_gh_unwrapped_h;
        s_gh_base_v = s_gh_unwrapped_v;
        s_gh_frame_raw_h = ppu->hScroll[0];
        s_gh_frame_raw_v = ppu->vScroll[0];
    }
    if (!s_gh_scene_ok) return;
    /* HUD bands repoint BG1's map base. Never harvest those lines. */
    if (PPU_bgTilemapAdr(ppu, 0) != s_gh_map_base) return;

    int dh = WsGhostWrapDelta(ppu->hScroll[0], s_gh_frame_raw_h);
    int dv = WsGhostWrapDelta(ppu->vScroll[0], s_gh_frame_raw_v);
    int32_t h = s_gh_base_h + dh, v = s_gh_base_v + dv;
    int64_t sy = (int64_t)v + (int)line;
    int32_t wy = WsOwFloor16(sy);
    int cy = wy & 31;
    int x = 0;
    while (x < 256) {
        int64_t sx = (int64_t)h + x;
        int32_t wx = WsOwFloor16(sx);
        int cx = wx & 31;
        WsGhostCell *g = &s_gh[cy][cx];
        g->wx = wx;
        g->wy = wy;
        g->tile = ppu->vram[(s_gh_map_base + ((cy & 31) << 5) +
                             (cx & 31)) & 0x7FFF];
        g->valid = 1;
        x += 16 - WsOwMod16(sx);
    }
}

static void WsGhostDraw(void)
{
    SnesBeamLineHook *old_line = g_snes_beam_line_hook;
    void *old_line_ctx = g_snes_beam_line_ctx;
    PpuMarginTileHook *old_margin = g_ppu_margin_tile_hook;
    void *old_margin_ctx = g_ppu_margin_tile_ctx;
    int old_counter = snes_frame_counter;

    snes_frame_counter = WS_GHOST_SENTINEL;
    g_snes_beam_line_hook = &WsGhostLine;
    g_snes_beam_line_ctx = NULL;
    g_ppu_margin_tile_hook = NULL;
    g_ppu_margin_tile_ctx = NULL;
    s_gh_frame_active = 1;
    s_gh_scene_ok = 1;
    snes_beam_frame_driver_draw_ppu_frame();
    s_gh_frame_active = 0;

    g_snes_beam_line_hook = old_line;
    g_snes_beam_line_ctx = old_line_ctx;
    g_ppu_margin_tile_hook = old_margin;
    g_ppu_margin_tile_ctx = old_margin_ctx;
    snes_frame_counter = old_counter;
    s_gh_valid = s_gh_scene_ok && s_gh_chr_ready;
}

void GameGhostAfterRunFrame(const struct SnesDesktopHostFrameStats *stats)
{
    (void)stats;
    if (s_ghost_in_hook) return;

    if (!WsGhostEligible()) {
        s_ghost_valid = 0;
        s_gh_valid = 0;
        s_ghost_input_valid = 0;
        return;
    }
    WsGhostChrCheck();
    if (!WsGhostEnsureBuffers()) return;

    s_ghost_in_hook = 1;

    uint32_t real_pc;
    bool real_wai;
    snes_beam_frame_driver_get_exec(&real_pc, &real_wai);
    WsCullState real_cull;
    WsCullGet(&real_cull);
    uint32_t audio_cursor = RtlAudioProducerCursor();
    bool saved_spec = RtlSpeculativeFrame();
    bool saved_render = g_snes->disableRender;
    SnesBeamLineHook *saved_line = g_snes_beam_line_hook;
    void *saved_line_ctx = g_snes_beam_line_ctx;
    PpuMarginTileHook *saved_margin = g_ppu_margin_tile_hook;
    void *saved_margin_ctx = g_ppu_margin_tile_ctx;

    ppu_rasterStateSave(s_raster_save, s_raster_save_size);
    if (g_ppu) memcpy(&s_ghost_ppu_save, g_ppu, sizeof(Ppu));
    s_re_len = RtlRollbackSaveToMemory(s_re_blob, s_re_cap);
    if (!s_re_len) {
        if (!s_ghost_warned) {
            fprintf(stderr, "[ws-ghost] real snapshot failed; lane idle\n");
            s_ghost_warned = 1;
        }
        s_ghost_in_hook = 0;
        return;
    }

    uint32_t inputs = (uint32_t)g_snes->input1_currentState |
                      ((uint32_t)g_snes->input2_currentState << 12);
    int resync = 0;
    if (!s_ghost_valid || !s_ghost_input_valid || inputs != s_ghost_input ||
        s_ow_scene_generation != s_ghost_scene_gen ||
        s_ghost_frames_since_resync >= WsGhostResync())
        resync = 1;

    if (!resync) {
        if (!RtlRollbackLoadFromMemory(s_gh_blob, s_gh_len)) {
            /* The machine may be partially changed; put the real state back
             * before doing anything else. */
            resync = 1;
            if (!RtlRollbackLoadFromMemory(s_re_blob, s_re_len)) {
                if (!s_ghost_warned) {
                    fprintf(stderr, "[ws-ghost] real rollback failed; lane "
                                    "disabled\n");
                    s_ghost_warned = 1;
                }
                s_ghost_valid = 0;
                s_gh_valid = 0;
                s_ghost_in_hook = 0;
                return;
            }
            snes_beam_frame_driver_set_exec(real_pc, real_wai);
            WsCullSet(&real_cull);
        } else {
            snes_beam_frame_driver_set_exec(s_ghost_pc, s_ghost_wai);
            WsCullSet(&s_ghost_cull);
            s_ghost_lead -= 1;
        }
    }

    if (resync) {
        s_ghost_valid = 0;
        s_ghost_lead = 0;
        s_ghost_frames_since_resync = 0;
        s_ghost_scene_gen = s_ow_scene_generation;
        memset(s_gh, 0, sizeof(s_gh));
        s_gh_valid = 0;
        s_ghost_pc = real_pc;
        s_ghost_wai = real_wai;
        s_ghost_cull = real_cull;
        WsGhostSeedScroll();
    }
    s_ghost_input = inputs;
    s_ghost_input_valid = 1;

    int ahead = WsGhostAhead();
    int maxsteps = WsGhostMaxSteps();
    int steps = 0;
    if (ahead > 0) {
        steps = s_ghost_lead < ahead ? ahead - s_ghost_lead : 1;
        if (steps > maxsteps) steps = maxsteps;
        if (steps < 0) steps = 0;
    } else {
        s_gh_valid = 0;
        s_ghost_valid = 0;
    }

    if (steps > 0) {
        RtlSetSpeculativeFrame(true);
        for (int i = 0; i < steps; i++) {
            snes_frame_counter = WS_GHOST_SENTINEL;
            RtlRunFrame(inputs);
            WsGhostDraw();
            s_ghost_lead++;
        }
        RtlSetSpeculativeFrame(false);

        s_gh_len = RtlRollbackSaveToMemory(s_gh_blob, s_gh_cap);
        s_ghost_valid = s_gh_len != 0;
        if (s_ghost_valid) {
            snes_beam_frame_driver_get_exec(&s_ghost_pc, &s_ghost_wai);
            WsCullGet(&s_ghost_cull);
        }
    }
    s_ghost_frames_since_resync++;

    RtlAudioRewindProducer(audio_cursor);
    if (!RtlRollbackLoadFromMemory(s_re_blob, s_re_len)) {
        if (!s_ghost_warned) {
            fprintf(stderr, "[ws-ghost] real rollback load FAILED; state may "
                            "have advanced\n");
            s_ghost_warned = 1;
        }
    }
    snes_beam_frame_driver_set_exec(real_pc, real_wai);
    WsCullSet(&real_cull);
    if (g_ppu) memcpy(g_ppu, &s_ghost_ppu_save, sizeof(Ppu));
    ppu_rasterStateLoad(s_raster_save, s_raster_save_size);
    RtlSetSpeculativeFrame(saved_spec);
    g_snes->disableRender = saved_render;
    g_snes_beam_line_hook = saved_line;
    g_snes_beam_line_ctx = saved_line_ctx;
    g_ppu_margin_tile_hook = saved_margin;
    g_ppu_margin_tile_ctx = saved_margin_ctx;

    if (!s_ghost_announced) {
        s_ghost_announced = 1;
        fprintf(stderr, "[ws-ghost] active: ahead=%d maxsteps=%d resync=%d "
                        "snapshot=%zu bytes\n", ahead, maxsteps,
                WsGhostResync(), s_re_len);
    }
    s_ghost_in_hook = 0;
}

void GameDrawPpuFrame(void)
{
    if (g_ppu) WsInjectTestOam(g_ppu);
    int ow_mode = g_ppu && WideEnabled() && InLiveRace() ? WsOffwindowMode() : 0;
    if (!ow_mode) WsOwReset();
    if (WsOffwindowMode() && WideEnabled()) {
        int live = InLiveRace();
        if (live != s_ow_live_prev) {
            s_ow_live_prev = live;
            fprintf(stderr, "[ws-ow] %s at frame %d (b4=%u ee9=%u 300=%u)\n",
                    live ? "ACTIVE" : "inactive", snes_frame_counter,
                    g_ram[0x0B4], g_ram[0x0EE9], g_ram[0x0300]);
        }
    }
    if (WideEnabled() && InLiveRace() && g_ppu && WsHudEnabled()) {
        /* BG3 is per-band: top groups are elastic, the lower prompt/arrow/
         * lap-time rows keep the authentic clamp. The layer-wide clamp would
         * win over the elastic band, so it must not be set here. */
        PpuSetWidescreenLayerClampBand(g_ppu, 2, 31, 224);
    } else if (WideEnabled() && InLiveRace() && g_ppu) {
        PpuSetWidescreenLayerClamp(g_ppu, 1u << 2);
    }
    if (g_ppu && WideEnabled() && InLiveRace() && !ow_mode &&
        !WsTrackRepeatEnabled() && getenv("SNESRECOMP_WS_TRACK_CLAMP")) {
        /* Interim safety: BG1 is the track layer; its 32x32 map wraps at 256,
         * so the extra margins show a disconnected track section. */
        PpuSetWidescreenLayerClamp(g_ppu, 1u << 0);
    }
    if (g_ppu && WideEnabled() && InLiveRace() && !ow_mode &&
        WsTrackRepeatEnabled())
        WsRepeatBegin(g_ppu);
    WsApplyHud(g_ppu);
    if (ow_mode) {
        g_snes_beam_line_hook = &WsOffwindowLine;
        g_snes_beam_line_ctx = NULL;
        g_ppu_margin_tile_hook = &WsOffwindowTile;
        g_ppu_margin_tile_ctx = NULL;
    }
    snes_beam_frame_driver_draw_ppu_frame();
    if (ow_mode) {
        g_snes_beam_line_hook = NULL;
        g_ppu_margin_tile_hook = NULL;
        if (ow_mode == 2 && s_ow_frame_active)
            WsSrcFrame();
        s_ow_frame_active = 0;
    } else {
        WsSrcInvalidate();
    }
    WsRepeatEnd(g_ppu);
}

void GameSessionReset(void)
{
    /* Rematch / soft-return: clear anything that must not survive a new
     * session. recomp-ai-rules/NETPLAY.md §3 — sticky state that "has always
     * been fine" is the usual desync culprit, because single-player never
     * re-enters the boot path twice in one process. */
    snes_beam_frame_driver_reset();
}

const RtlGameInfo kGameInfo = {
    .title = "uniracers",
    .initialize = NULL,
    .run_frame = &GameRunOneFrame,
    .draw_ppu_frame = &GameDrawPpuFrame,
    .save_name_prefix = "save",
    .session_reset = &GameSessionReset,
};
