+/* The rider staging code sets the OAM X high bit only for negative X. The
+ * native right cull is 256, so a positive X can never reach the high bit; our
+ * widened cull admits [256, 256 + E) and those uploads would decode as X-256,
+ * drawing a phantom on the left. Resolve the ambiguity from the rider's true
+ * WRAM X and set the missing bit in the PPU's uploaded high table only. Never
+ * write guest memory. */
+#define WS_OAM_XHIGH_SLACK 32
+
+static int WsOamXHighEnabled(void)
+{
+    const char *e = getenv("SNESRECOMP_WS_OAM_XHIGH");
+    return !(e && *e && strcmp(e, "0") == 0);
+}
+
+static void WsOamXHighLog(int slot, int lo, int want)
+{
+    const char *path = getenv("SNESRECOMP_WS_OAM_XHIGH_LOG");
+    if (!path || !*path) return;
+    static FILE *f;
+    if (!f) {
+        f = fopen(path, "w");
+        if (!f) return;
+        fprintf(f, "frame,slot,lo,want\n");
+    }
+    fprintf(f, "%d,%d,%d,%d\n", snes_frame_counter, slot, lo, want);
+    fflush(f);
+}
+
+static void WsFixRiderOamXHigh(Ppu *ppu)
+{
+    if (!ppu) return;
+    if (!WideEnabled() || !InLiveRace()) return;
+    if (g_ram[0x0DDB] != 0) return;            /* 2P split screen */
+    if (!WsCullEnabled() || WsExtra() <= 0) return;
+    if (!WsOamXHighEnabled()) return;
+
+    const int e = WsExtra();
+    const int cam = (int16_t)WsRead16(0x0419);
+    const int cam_y = (int16_t)WsRead16(0x041D);
+    static const uint16 wx_addr[2] = { 0x0411, 0x0413 }; /* player, rival */
+    static const uint16 wy_addr[2] = { 0x0415, 0x0417 };
+    for (int i = 0; i < 2; i++) {
+        const int slot = 98 + i;
+        const int lo = ppu->oam[slot * 2] & 0xFF;
+        const int y = ppu->oam[slot * 2] >> 8;
+        const int bit = (slot & 3) * 2;
+        const int hi = (ppu->highOam[slot >> 2] >> bit) & 1;
+        if (hi && lo == 0x70 && y == 0x70) {
+            /* A culled rider is parked at X=$170 (-144), Y=112, large. 4:3
+             * and 16:9 never reach it, but past E ~ 96 its edge shows in the
+             * left margin (or the right one once E >= 112). Keep it only if
+             * the rider really is there; otherwise move it below the field
+             * as a small sprite, which no small size (<= 32 px) can wrap. */
+            int rel = (int16_t)(WsRead16(wx_addr[i]) - (uint16)cam);
+            int rel_y = (int16_t)(WsRead16(wy_addr[i]) - (uint16)cam_y);
+            /* Tight tolerance: the cull edge is only ~13 px from -144, and
+             * a rider culled there must not be mistaken for a real one. */
+            if (abs(rel + 144) > 4 || abs(rel_y - 112) > 4) {
+                ppu->oam[slot * 2] = (uint16)((0xE0 << 8) | lo);
+                ppu->highOam[slot >> 2] &= (uint8)~(2u << bit);
+                WsOamXHighLog(slot, -1, rel);
+            }
+            continue;
+        }
+        if (hi) continue;
+        if (lo >= e) continue;                 /* only the aliased [0,E) range */
+        int16_t rel = (int16_t)(WsRead16(wx_addr[i]) - (uint16)cam);
+        /* The OAM X is the unshifted rel: the game does TAX before the
+         * $03ED shift loop, which only feeds the cull compare. */
+        int32_t want = rel;
+        if (want < 256 - WS_OAM_XHIGH_SLACK ||
+            want >= 256 + e + WS_OAM_XHIGH_SLACK)
+            continue;
+        /* Tolerate the up-to-one-frame lag of the WRAM position behind the
+         * uploaded OAM value: only the clear winner gets the bit. */
+        int d_lo = abs(lo - (int)want);
+        int d_hi = abs((lo + 256) - (int)want);
+        if (d_hi >= d_lo) continue;
+        ppu->highOam[slot >> 2] |= (uint8)(1u << bit);
+        WsOamXHighLog(slot, lo, (int)want);
+    }
+}
