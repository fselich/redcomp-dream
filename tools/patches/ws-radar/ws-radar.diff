+/* ── Local radar (openspec/changes/uniracers-ws-radar) ────────────────────
+ *
+ * A 32x32 RGB15 panel in the bottom-right margin. Each panel pixel covers a
+ * 2x2 block of the 64x64-cell window around the player, read from the decoded
+ * $7F track table through the same source anchor as the margins. The player
+ * and rival dots come from the live WRAM rider/camera positions. The panel is
+ * a PpuExtraObject: presentation-only, no guest memory writes. */
+#define WS_RADAR_W 64
+#define WS_RADAR_H 32
+#define WS_RADAR_WINDOW_X 128
+#define WS_RADAR_WINDOW_Y 64
+#define WS_RADAR_OPAQUE 0x8000u
+#define WS_RADAR_BG (WS_RADAR_OPAQUE | 0x0842u)
+#define WS_RADAR_EDGE (WS_RADAR_OPAQUE | 0x5294u)
+#define WS_RADAR_TRACK (WS_RADAR_OPAQUE | 0x03E0u)
+#define WS_RADAR_PLAYER (WS_RADAR_OPAQUE | 0x7FFFu)
+#define WS_RADAR_RIVAL (WS_RADAR_OPAQUE | 0x001Fu)
+
+static int s_radar_enabled = 1;
+static uint16_t s_radar_px[WS_RADAR_W * WS_RADAR_H];
+static PpuExtraObject s_radar_obj;
+static FILE *s_radar_log;
+
+static char *WsRadarTrim(char *s)
+{
+    while (*s == ' ' || *s == '\t' || *s == '\r' || *s == '\n') s++;
+    char *e = s + strlen(s);
+    while (e > s && (e[-1] == ' ' || e[-1] == '\t' || e[-1] == '\r' ||
+                     e[-1] == '\n'))
+        e--;
+    *e = 0;
+    return s;
+}
+
+static int WsRadarCiEq(const char *a, const char *b)
+{
+    while (*a && *b) {
+        char ca = *a, cb = *b;
+        if (ca >= 'A' && ca <= 'Z') ca = (char)(ca + 32);
+        if (cb >= 'A' && cb <= 'Z') cb = (char)(cb + 32);
+        if (ca != cb) return 0;
+        a++, b++;
+    }
+    return *a == *b;
+}
+
+/* -1 means "not a boolean"; the caller keeps its previous value. */
+static int WsRadarBool(const char *v, int def)
+{
+    if (WsRadarCiEq(v, "1") || WsRadarCiEq(v, "true") ||
+        WsRadarCiEq(v, "on") || WsRadarCiEq(v, "yes"))
+        return 1;
+    if (WsRadarCiEq(v, "0") || WsRadarCiEq(v, "false") ||
+        WsRadarCiEq(v, "off") || WsRadarCiEq(v, "no"))
+        return 0;
+    return def;
+}
+
+/* Host-owned [Video] section: the framework parser accepts unknown keys there
+ * silently, so the game can read MiniMap without a snesrecomp change. */
+static void WsRadarReadConfig(const char *path)
+{
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[512];
+    int in_video = 0;
+    while (fgets(line, sizeof(line), f)) {
+        char *hash = strpbrk(line, ";#");
+        if (hash) *hash = 0;
+        char *p = WsRadarTrim(line);
+        if (!*p) continue;
+        if (*p == '[') {
+            in_video = WsRadarCiEq(p, "[Video]");
+            continue;
+        }
+        if (!in_video) continue;
+        char *eq = strchr(p, '=');
+        if (!eq) continue;
+        *eq = 0;
+        char *key = WsRadarTrim(p);
+        char *val = WsRadarTrim(eq + 1);
+        if (WsRadarCiEq(key, "MiniMap")) {
+            int b = WsRadarBool(val, s_radar_enabled);
+            if (b >= 0) s_radar_enabled = b;
+        }
+    }
+    fclose(f);
+}
+
+void GameAfterConfig(void)
+{
+    s_radar_enabled = 1;
+    WsRadarReadConfig("config.ini");
+    WsRadarReadConfig("config.local.ini");
+    const char *e = getenv("SNESRECOMP_WS_MINIMAP");
+    if (e && *e) {
+        int b = WsRadarBool(e, s_radar_enabled);
+        if (b >= 0) s_radar_enabled = b;
+    }
+}
+
+static int WsRadarHalf(int v)
+{
+    return v >= 0 ? v / 2 : -((-v + 1) / 2);
+}
+
+static int WsRadarRiderCell(uint16 xaddr, uint16 yaddr,
+                            int32_t *tx, int32_t *ty)
+{
+    if (!s_ow_scroll_valid || s_src_valid <= 0) return 0;
+    int16_t rx = (int16_t)WsRead16(xaddr);
+    int16_t ry = (int16_t)WsRead16(yaddr);
+    int16_t cx = (int16_t)WsRead16(0x0419);
+    int16_t cy = (int16_t)WsRead16(0x041D);
+    int16_t sx = (int16_t)(rx - cx);
+    int16_t sy = (int16_t)(ry - cy);
+    int32_t wx = WsOwFloor16((int64_t)s_ow_unwrapped_h + sx);
+    int32_t wy = WsOwFloor16((int64_t)s_ow_unwrapped_v + sy);
+    *tx = wx + s_src_ax[0];
+    *ty = wy + s_src_ay[0];
+    return 1;
+}
+
+static void WsRadarUpdate(Ppu *ppu)
+{
+    if (!ppu) return;
+
+    int eligible = s_radar_enabled && WideEnabled() && InLiveRace() &&
+                   g_ram[0x0DDB] == 0 && WsExtra() > 0 &&
+                   s_src_valid > 0 && !snes_netplay_active();
+    if (!eligible) {
+        PpuSetExtraObjects(ppu, NULL, 0);
+        return;
+    }
+
+    int32_t ptx, pty, rtx, rty;
+    if (!WsRadarRiderCell(0x0411, 0x0415, &ptx, &pty) ||
+        !WsRadarRiderCell(0x0413, 0x0417, &rtx, &rty)) {
+        PpuSetExtraObjects(ppu, NULL, 0);
+        return;
+    }
+
+    int half_x = WS_RADAR_WINDOW_X / 2;
+    int half_y = WS_RADAR_WINDOW_Y / 2;
+    for (int py = 0; py < WS_RADAR_H; py++) {
+        for (int px = 0; px < WS_RADAR_W; px++) {
+            uint16_t c = WS_RADAR_BG;
+            if (px == 0 || px == WS_RADAR_W - 1 ||
+                py == 0 || py == WS_RADAR_H - 1) {
+                c = WS_RADAR_EDGE;
+            } else {
+                int tx = ptx - half_x + px * 2;
+                int ty = pty - half_y + py * 2;
+                int track = 0;
+                for (int dy = 0; dy < 2 && !track; dy++) {
+                    for (int dx = 0; dx < 2; dx++) {
+                        uint16_t w;
+                        if (WsSrcCell(tx + dx, ty + dy, &w) &&
+                            (w & 0x03FF)) {
+                            track = 1;
+                            break;
+                        }
+                    }
+                }
+                c = track ? WS_RADAR_TRACK : WS_RADAR_BG;
+            }
+            s_radar_px[py * WS_RADAR_W + px] = c;
+        }
+    }
+
+    int rx = WS_RADAR_W / 2 + WsRadarHalf(rtx - ptx);
+    int ry = WS_RADAR_H / 2 + WsRadarHalf(rty - pty);
+    if (rx < 1) rx = 1;
+    if (rx > WS_RADAR_W - 2) rx = WS_RADAR_W - 2;
+    if (ry < 1) ry = 1;
+    if (ry > WS_RADAR_H - 2) ry = WS_RADAR_H - 2;
+    s_radar_px[ry * WS_RADAR_W + rx] = WS_RADAR_RIVAL;
+    s_radar_px[(WS_RADAR_H / 2) * WS_RADAR_W + WS_RADAR_W / 2] =
+        WS_RADAR_PLAYER;
+
+    const char *logpath = getenv("SNESRECOMP_WS_RADAR_LOG");
+    if (logpath && *logpath) {
+        uint16_t pword = 0, rword = 0;
+        WsSrcCell(ptx, pty, &pword);
+        WsSrcCell(rtx, rty, &rword);
+        if (!s_radar_log) {
+            s_radar_log = fopen(logpath, "w");
+            if (s_radar_log)
+                fprintf(s_radar_log,
+                        "# frame,ptx,pty,rtx,rty,ax,ay,pword,rword\n");
+        }
+        if (s_radar_log) {
+            fprintf(s_radar_log, "%d,%d,%d,%d,%d,%d,%d,%04x,%04x\n",
+                    snes_frame_counter, ptx, pty, rtx, rty,
+                    s_src_ax[0], s_src_ay[0], pword, rword);
+            fflush(s_radar_log);
+        }
+    }
+
+    s_radar_obj.x = 256 + (int)ppu->extraRightCur - WS_RADAR_W - 2;
+    s_radar_obj.y = 224 - WS_RADAR_H - 2;
+    s_radar_obj.width = WS_RADAR_W;
+    s_radar_obj.height = WS_RADAR_H;
+    s_radar_obj.stride = WS_RADAR_W;
+    s_radar_obj.priority = 3;
+    s_radar_obj.math = 1;
+    s_radar_obj.oamSlot = 127;
+    s_radar_obj.order = 1;
+    s_radar_obj.pixels = s_radar_px;
+    PpuSetExtraObjects(ppu, &s_radar_obj, 1);
+}
+
