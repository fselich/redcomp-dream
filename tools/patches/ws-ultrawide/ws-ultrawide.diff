+        *frame_w = 256;
+        return;
+    }
+    SnesDisplayFrame f = SnesDisplayAspect_ComputeAdaptiveFrame(
+        256, 224, kWsRaceMaxWidth, WsTargetAspect(drawable_w, drawable_h),
+        SnesDisplayAspect_Clamp(g_config.display_aspect));
+    *frame_w = f.width;
 }
 
