+/* P2c HUD: BG3 is separate rigid groups, not one continuous bar. Keep the
+ * normal clamp for the prompt/arrow/lap-time rows, and on the top band copy
+ * the left group (RACE / 0/3, source 17..64) to the left edge and the timer
+ * (source 193..256) to the right edge. Equal source/destination widths make
+ * both segments 1:1, so glyphs are never resampled. The 17 px left inset is
+ * deliberately removed by the left segment; the 17 px right inset is kept.
+ * SNESRECOMP_WS_HUD=0 restores the clamp. */
+static int WsHudEnabled(void)
+{
+    const char *e = getenv("SNESRECOMP_WS_HUD");
+    if (e && *e) return strcmp(e, "0") != 0;
+    return 1;
+}
+
+static void WsApplyHud(Ppu *ppu)
+{
+    if (!ppu) return;
+    if (!WideEnabled() || !InLiveRace() || !WsHudEnabled()) {
+        PpuSetWidescreenLayerElasticBandSlot(ppu, 0, 2, 0, 0, NULL, 0);
+        PpuSetWidescreenBg3Widen(ppu, 0);
+        return;
+    }
+    /* BG3 needs its own widen gate before the elastic band is consulted. */
+    PpuSetWidescreenBg3Widen(ppu, 17);
+    const PpuWsElasticSeg segs[2] = {
+        { 17, 64, -39, 8 },     /* left group + 4 px inset, 1:1 */
+        { 193, 256, 236, 299 }, /* timer + right inset, 1:1 */
+    };
+    PpuSetWidescreenLayerElasticBandSlot(ppu, 0, 2, 17, 31, segs, 2);
+}
