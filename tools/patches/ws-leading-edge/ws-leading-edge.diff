+/* Test-only generator probe. It runs the real stage 1/2 on a snapshot of a
+ * live race frame and logs the inputs, raw source words and outputs. This is
+ * deliberately not a production path; it exists to decode the table/world
+ * mapping before any wide-map renderer is written. */
+static void WsTestGen(void)
+{
+    static int done;
+    const char *enable = getenv("SNESRECOMP_WS_TEST_GEN");
+    if (done || !enable || !*enable || !InLiveRace()) return;
+    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
+    int trigger = frame_env && *frame_env ? atoi(frame_env) : 5000;
+    if (snes_frame_counter < trigger) return;
+    done = 1;
+
+    CpuState saved_cpu = g_cpu;
+    static uint8 saved_ram[0x20000];
+    memcpy(saved_ram, g_ram, sizeof(saved_ram));
+
+    fprintf(stderr,
+            "[wsmap] frame=%d a5=%04x a7=%04x 0405=%04x 0407=%04x "
+            "04f1=%04x 04f3=%04x 0232=%04x 0234=%04x 0236=%04x "
+            "0238=%04x\n",
+            snes_frame_counter, WsRead16(0x00A5), WsRead16(0x00A7),
+            WsRead16(0x0405), WsRead16(0x0407), WsRead16(0x04F1),
+            WsRead16(0x04F3), WsRead16(0x0232), WsRead16(0x0234),
+            WsRead16(0x0236), WsRead16(0x0238));
+
+    for (int off = -512; off <= 512; off += 8) {
+        memcpy(g_ram, saved_ram, sizeof(saved_ram));
+        g_cpu = saved_cpu;
+        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
+        RecompReturn r1 = cpu_dispatch_call_pc(&g_cpu, 0x818A4A, 0x818A4A);
+        fprintf(stderr,
+                "[wsgen1] off=%d ret=%d a5=%04x 0405=%04x 0407=%04x "
+                "0232=%04x 0234=%04x 0236=%04x 0238=%04x "
+                "0260=%04x 0262=%04x 0264=%04x 0266=%04x "
+                "0268=%04x 026a=%04x 026c=%04x 026e=%04x "
+                "0270=%04x 0272=%04x\n",
+                off, (int)r1, WsRead16(0x00A5), WsRead16(0x0405),
+                WsRead16(0x0407), WsRead16(0x0232), WsRead16(0x0234),
+                WsRead16(0x0236), WsRead16(0x0238), WsRead16(0x0260),
+                WsRead16(0x0262), WsRead16(0x0264), WsRead16(0x0266),
+                WsRead16(0x0268), WsRead16(0x026A), WsRead16(0x026C),
+                WsRead16(0x026E), WsRead16(0x0270), WsRead16(0x0272));
+
+        memcpy(g_ram, saved_ram, sizeof(saved_ram));
+        g_cpu = saved_cpu;
+        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
+        RecompReturn r2 = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
+        fprintf(stderr,
+                "[wsgen2] off=%d ret=%d a5=%04x 0230=%04x 0232=%04x "
+                "0234=%04x 0236=%04x 0238=%04x 023a=%04x 023c=%04x "
+                "023e=%04x 0240=%04x 0242=%04x\n",
+                off, (int)r2, WsRead16(0x00A5), WsRead16(0x0230),
+                WsRead16(0x0232), WsRead16(0x0234), WsRead16(0x0236),
+                WsRead16(0x0238), WsRead16(0x023A), WsRead16(0x023C),
+                WsRead16(0x023E), WsRead16(0x0240), WsRead16(0x0242));
+        fflush(stderr);
+    }
+
+    memcpy(g_ram, saved_ram, sizeof(saved_ram));
+    g_cpu = saved_cpu;
+}
