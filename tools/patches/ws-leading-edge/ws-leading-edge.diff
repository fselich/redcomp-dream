+/* The object cull compares screen X against $0421 (left) and $0423 (right).
+ * Those two words are only written by the rider setup at $81:A385.. and only
+ * read by the five CMP sites at $82:AD19/ADE7/AEA7/AF75/AFFE, so shifting
+ * them is a pure cull change: spawn, AI, camera, collision and RNG never see
+ * them. At frame 3500 the native window is [-49, 256]; 16:9 needs [-92, 299]
+ * so the CPU ghost can reach the widened right margin. Keep the vertical
+ * window and every other object path untouched. */
+#define WS_CULL_MARGIN 43
+#define WS_CULL_LEFT   0x0421
+#define WS_CULL_RIGHT  0x0423
+
+static int s_cull_on;
+static uint16 s_cull_base_l, s_cull_base_r;
+static uint16 s_cull_applied_l, s_cull_applied_r;
+
+static int WsCullEnabled(void)
+{
+    const char *e = getenv("SNESRECOMP_WS_CULL");
+    if (e && *e) return strcmp(e, "0") != 0;
+    return 1;
+}
+
+static uint16 WsRead16(uint16 addr)
+{
+    return (uint16)(g_ram[addr] | ((uint16)g_ram[(uint16)(addr + 1)] << 8));
+}
+
+static void WsWrite16(uint16 addr, uint16 value)
+{
+    g_ram[addr] = (uint8)(value & 0xFF);
+    g_ram[(uint16)(addr + 1)] = (uint8)(value >> 8);
+}
+
+static void WsRestoreCull(void)
+{
+    if (!s_cull_on) return;
+    /* Only restore if the game has not replaced our widened value. */
+    if (WsRead16(WS_CULL_LEFT) == s_cull_applied_l &&
+        WsRead16(WS_CULL_RIGHT) == s_cull_applied_r) {
+        WsWrite16(WS_CULL_LEFT, s_cull_base_l);
+        WsWrite16(WS_CULL_RIGHT, s_cull_base_r);
+    }
+    s_cull_on = 0;
+}
+
+static void WsApplyCull(void)
+{
+    if (!WideEnabled() || !InLiveRace() || !WsCullEnabled()) {
+        WsRestoreCull();
+        return;
+    }
+
+    uint16 cur_l = WsRead16(WS_CULL_LEFT);
+    uint16 cur_r = WsRead16(WS_CULL_RIGHT);
+
+    /* Reuse the base while our widened values are in place. A different pair
+     * means the game just installed a new per-section/per-rider base. */
+    if (!s_cull_on || cur_l != s_cull_applied_l || cur_r != s_cull_applied_r) {
+        /* Wait for a plausible native screen window: setup writes 0 first. */
+        if ((int16)cur_l > 0 || cur_r < 128) {
+            s_cull_on = 0;
+            return;
+        }
+        s_cull_base_l = cur_l;
+        s_cull_base_r = cur_r;
+    }
+
+    s_cull_applied_l = (uint16)((int16)s_cull_base_l - WS_CULL_MARGIN);
+    s_cull_applied_r = (uint16)(s_cull_base_r + WS_CULL_MARGIN);
+    WsWrite16(WS_CULL_LEFT, s_cull_applied_l);
+    WsWrite16(WS_CULL_RIGHT, s_cull_applied_r);
+    s_cull_on = 1;
+}
