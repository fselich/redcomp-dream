+/* Test-only: scan horizontal world offsets through the real stage 2, logging
+ * whether the resulting BG1 staging column is nonblank. */
+static void WsTestStage2Scan(void)
+{
+    static int done;
+    const char *enable = getenv("SNESRECOMP_WS_TEST_STAGE2_SCAN");
+    if (done || !enable || !*enable || !InLiveRace()) return;
+    const char *frame_env = getenv("SNESRECOMP_WS_TEST_GEN_FRAME");
+    int trigger = frame_env && *frame_env ? atoi(frame_env) : 3504;
+    if (snes_frame_counter < trigger) return;
+    done = 1;
+
+    CpuState saved_cpu = g_cpu;
+    static uint8 saved_ram[0x20000];
+    memcpy(saved_ram, g_ram, sizeof(saved_ram));
+    for (int off = -512; off <= 512; off += 8) {
+        memcpy(g_ram, saved_ram, sizeof(saved_ram));
+        g_cpu = saved_cpu;
+        WsWrite16(0x00A5, (uint16)(WsRead16(0x00A5) + off));
+        RecompReturn r = cpu_dispatch_call_pc(&g_cpu, 0x818B95, 0x818B95);
+        int nonblank = 0;
+        for (int i = 0; i < 10; i++)
+            if (WsRead16((uint16)(0x0230 + i * 2)) != 0x00A0) nonblank++;
+        fprintf(stderr, "[ws2scan] off=%d ret=%d nonblank=%d "
+                        "0230=%04x 0232=%04x 0234=%04x 0236=%04x "
+                        "0238=%04x 023a=%04x 0260=%04x 0262=%04x "
+                        "0264=%04x 0266=%04x\n",
+                off, (int)r, nonblank, WsRead16(0x0230), WsRead16(0x0232),
+                WsRead16(0x0234), WsRead16(0x0236), WsRead16(0x0238),
+                WsRead16(0x023A), WsRead16(0x0260), WsRead16(0x0262),
+                WsRead16(0x0264), WsRead16(0x0266));
+        fflush(stderr);
+    }
+    memcpy(g_ram, saved_ram, sizeof(saved_ram));
+    g_cpu = saved_cpu;
+}
